@page
@model SalesManagement.Pages.Categories.IndexModel
@{
    ViewData["Title"] = "Categories";
}

<div class="page-header">
    <h1 class="page-title">Categories</h1>
</div>

<div class="row g-3">
    <div class="col-lg-7">
        <div class="card">
            <div class="table-responsive">
                <table class="table table-hover data-table">
                    <thead>
                        <tr><th>Name</th><th class="num">Products</th><th></th></tr>
                    </thead>
                    <tbody>
                        @foreach (var c in Model.Categories)
                        {
                            <tr>
                                <td>@c.Name</td>
                                <td class="num">@c.ProductCount</td>
                                <td>
                                    <div class="row-actions">
                                        <form method="post" asp-page-handler="Delete" asp-route-id="@c.CategoryId"
                                              data-confirm="@($"Delete {c.Name}?")">
                                            <button type="submit" class="btn btn-sm btn-outline-danger">Delete</button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                        @if (!Model.Categories.Any())
                        {
                            <tr><td colspan="3" class="empty">No categories yet. Add one to start creating products.</td></tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <div class="col-lg-5">
        <div class="card">
            <div class="card-header"><h2 class="card-title-sm">Add category</h2></div>
            <div class="card-body">
                <form method="post" asp-page-handler="Add">
                    <div class="mb-3">
                        <label asp-for="NewName" class="form-label">Name</label>
                        <input asp-for="NewName" class="form-control" />
                        <span asp-validation-for="NewName" class="text-danger"></span>
                    </div>
                    <button type="submit" class="btn btn-primary">Add category</button>
                </form>
            </div>
        </div>
    </div>
</div>
